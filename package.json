{
  "name": "campus-cycle-monorepo",
  "version": "1.0.0",
  "description": "CampusCycle - College Second-Hand Marketplace Monorepo",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run dev",
    "server": "cd server && node server.js",
    "seed": "cd server && npm run seed",
    "build": "cd client && npm run build",
    "vercel-build": "cd client && npm install && npm run build && cd ../server && npm install",
    "test:e2e": "node test-e2e.mjs",
    "install:all": "npm install concurrently && cd server && npm install && cd ../client && npm install"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  }
}